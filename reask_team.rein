import { findTeam } from "./ask_team/find_team";
import { checkOtherTeam } from "./ask_team/check_other_team";
import { replyAndRecord } from "./reask_team/reply_and_record";
import { findChannel } from "./ask_team/find_and_post/find_channel";
import { noChannel } from "./ask_other/no_channel";
import { postTeam } from "./ask_team/find_and_post/post_team";

interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The title of the pull request. */
  title: string;
  /** The owner and repo, such as owner/repo. */
  repo: string;
  /** The Jira key, such as ABC-123, or none. */
  jira: string;
  /** The login of the author. */
  author: string;
  /** The base branch of the pull request. */
  base: string;
  /** Each changed file with its CODEOWNERS teams, or none. */
  owners: string;
  /** The head commit sha that is asked again. */
  sha: string;
  /** What changed since the asked head, in one line. */
  changed: string;
  /** The first review request comment of each channel, or none. */
  thread: string;
  /** The teams already asked at this head, separated by spaces, or none. */
  asked: string;
}

interface Team {
  /** Is a review team found? */
  found: boolean;
  /** The review team of the pull request, such as platform, or none. */
  team: string;
}

interface Other {
  /** Is an unmet approval of another team required to merge? */
  required: boolean;
  /** The other team's name without the org, or none. */
  other: string;
  /** Why that approval is required, in one line, or none. */
  reason: string;
}

interface Found {
  /** Is a channel chosen? */
  found: boolean;
  /** The channel as name (id), or none. */
  channel: string;
  /** The Slack user group mention as <!subteam^ID>, or none. */
  group: string;
}

interface Logged {
  /** Did the post succeed? */
  posted: boolean;
  /** Was the request recorded on the PR? */
  recorded: boolean;
}

/**
 * Re-ask a new head in the thread of the first request. An unmet team is asked
 * first. The re-ask is recorded only after every step before it worked.
 */
export default async function reaskTeam({ pr, title, repo, jira, author,
  base, owners, sha, changed, thread, asked }: Input) {
  /** The review team: the Jira Team Name, else the team of the author. */
  const team: Team = await request(findTeam(pr=pr, jira=jira,
    author=author));

  if (!team.found) {
    return `Return: no team for ${pr}. Nothing re-asked.`;
  }

  /** The first required team that is not asked at this head, if any. */
  const other: Other = await request(checkOtherTeam(pr=pr,
    repo=repo, base=base, owners=owners, team=team.team, asked=asked));

  if (!other.required) {
    return replyAndRecord(pr=pr, sha=sha, changed=changed,
      thread=thread);
  }

  /** The channel of that team, found at run time. */
  const extra: Found = await request(
    findChannel(team=other.other));

  if (!extra.found) {
    return noChannel(pr=pr, team=other.other);
  }

  /** The post of the team's request, then its record on the PR. */
  const logged: Logged = await request(
    postTeam(title=title, reason=other.reason,
    prs=`${pr} ${sha}`, label=`none`, channels=extra.channel,
    groups=extra.group, team=other.other));

  if (!logged.recorded) {
    return `Return: post or record for ${other.other} failed for ${pr}.`;
  }

  return replyAndRecord(pr=pr, sha=sha, changed=changed,
    thread=thread);
}
