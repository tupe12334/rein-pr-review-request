interface Input {
  /** The link of the pull request to ask a human to review. */
  pr: string;
}

interface Pr {
  /** The owner and repo, such as owner/repo. */
  repo: string;
  /** The title of the pull request. */
  title: string;
  /** The Jira key, such as ABC-123, or none. */
  jira: string;
  /** The login of the author. */
  author: string;
  /** The CODEOWNERS teams of the changed files, or none. */
  teams: string;
  /** The logins of the requested reviewers, or none. */
  reviewers: string;
  /** The head commit sha. */
  sha: string;
}

interface Place {
  /** Is the pull request in a workplace: a work owner with a Slack
   * workspace? */
  workplace: boolean;
}

interface Guard {
  /** Does this head already have a review request comment? */
  already_asked: boolean;
  /** Does any head already have a review request or a re-ask comment? */
  asked_before: boolean;
  /** Does this head already have a re-ask comment? */
  reasked: boolean;
  /** Was a human approval dismissed? */
  dismissed: boolean;
  /** Is there a human approval after the last push? */
  approved: boolean;
  /** What changed since the asked head, in one line, or none. */
  changed: string;
  /** The last review request or re-ask comment, or none. */
  last_post: string;
}

/**
 * Ask a human for a review of a pull request on Slack. The program posts
 * only when pr-handling calls it, and at most once per head.
 */
export default async function main({ pr }: Input) {
  /** The facts of the pull request that the request needs. */
  const info: Pr = await request(@./read_pr(pr=pr));

  /** Is the pull request in a workplace? A personal repository is not. */
  const place: Place = await request(@./check_workplace(pr=pr,
    repo=info.repo));

  if (!place.workplace) {
    return `Return: not workplace for ${pr}. Nothing posted.`;
  }

  /** The requests and approvals of this head and earlier heads. */
  const guard: Guard = await request(@./check_guards(pr=pr, sha=info.sha));

  if (guard.approved) {
    return `Return: not needed for ${pr}: a human approved it.`;
  }

  if (guard.reasked) {
    return `Return: already re-asked for ${pr} at this head.`;
  }

  if (guard.asked_before && (guard.dismissed || !guard.already_asked)) {
    return @./reply_and_record(pr=pr, sha=info.sha, changed=guard.changed,
      last_post=guard.last_post);
  }

  if (guard.already_asked) {
    return `Return: already asked for ${pr} at this head.`;
  }

  return @./find_and_post(pr=pr, title=info.title, repo=info.repo,
    teams=info.teams, reviewers=info.reviewers, sha=info.sha);
}
