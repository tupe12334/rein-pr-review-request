interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The head commit sha of the pull request. */
  sha: string;
}

/**
 * The text that checks the two guards: an earlier request for this head, and
 * a human approval after the last push. It changes nothing.
 */
export default function checkGuards({ pr, sha }: Input) {
  return `Read the comments and reviews of ${pr}: gh api --paginate
  repos/<owner>/<repo>/issues/<number>/comments, and gh api --paginate
  repos/<owner>/<repo>/pulls/<number>/reviews. Answer already_asked yes only
  if a comment by the account you act as (gh api user --jq .login) starts
  with the text "🤖 Review requested in" and names the head sha ${sha}.
  Otherwise answer already_asked no. Answer approved yes only if a review
  by a human, not a bot and not the account you act as, has state APPROVED
  and was submitted after the last commit of ${pr} (gh pr view ${pr} --json
  commits). Otherwise answer approved no. Change nothing.`;
}
