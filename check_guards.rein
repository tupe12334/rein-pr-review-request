interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The head commit sha of the pull request. */
  sha: string;
}

/**
 * The text that checks the guards: an earlier request, a re-ask, a dismissed
 * approval and a human approval after the last push. It changes nothing.
 */
export default function checkGuards({ pr, sha }: Input) {
  return `Read the comments and reviews of ${pr}: gh api --paginate
  repos/<owner>/<repo>/issues/<number>/comments, and gh api --paginate
  repos/<owner>/<repo>/pulls/<number>/reviews. Let login be the login of the
  account you act as: gh api user --jq .login. Answer already_asked yes only
  if a comment by login starts with the text "🤖 Review requested in" and
  names the head sha ${sha}. Otherwise answer already_asked no. Answer
  asked_before yes only if a comment by login starts with "🤖 Review requested
  in" or "🤖 Re-asked at", at any head. Otherwise answer asked_before no.
  Answer reasked yes only if a comment by login starts with "🤖 Re-asked at"
  and names the head sha ${sha}. Otherwise answer reasked no. Answer
  thread: the full text of the first comment by login that starts with
  "🤖 Review requested in", or none. Answer last_post: the full text of the
  last comment by login that starts with "🤖 Review requested in" or "🤖
  Re-asked at", or none. Answer dismissed yes only if a review by a human has
  state DISMISSED and was submitted after the last comment that last_post
  names. Otherwise answer dismissed no. Answer approved yes only if a review
  by a human, not a bot and not login, has state APPROVED and was submitted
  after the last commit of ${pr} (gh pr view ${pr} --json commits). Otherwise
  answer approved no. Answer changed: one line of what changed since the head
  that last_post names. When dismissed is yes, say that the earlier approval
  was dismissed, and name the commits since that head. Otherwise compare that
  head with ${sha} (gh api repos/<owner>/<repo>/compare/<that head>...${sha}
  --jq '.commits[].commit.message') and name the change in one line. Answer
  none when last_post is none. Change nothing.`;
}
