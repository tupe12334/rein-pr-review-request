interface Input {
  /** Each PR that waits for review as url sha, separated by semicolons. */
  prs: string;
  /** Each post as <#channel> (<permalink>), separated by semicolons. */
  links: string;
}

/**
 * The text that records each Slack post as a comment on each PR, so that
 * the next run sees the request for that head.
 */
export default function recordRequest({ prs, links }: Input) {
  return `For each PR in ${prs}, comment once on that PR with the text
  "🤖 Review requested in <#channel> (<permalink>) at <sha>", using the sha
  of that PR and the channel and the permalink of each post in ${links}.
  Change nothing else. Answer recorded yes when every comment was posted,
  otherwise no.`;
}
