interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The title of the pull request. */
  title: string;
  /** The logins of the requested reviewers, or none. */
  reviewers: string;
  /** The CODEOWNERS teams of the pull request, or none. */
  teams: string;
  /** The head commit sha that is asked. */
  sha: string;
  /** The chosen channels as name (id), separated by semicolons. */
  channels: string;
}

interface Posted {
  /** Did every post succeed? */
  posted: boolean;
  /** Each post as <#channel> (<permalink>), separated by semicolons. */
  links: string;
}

interface Recorded {
  /** Was a comment recorded on the PR for every post? */
  recorded: boolean;
}

/**
 * Post the review request in each chosen channel, then record each post as
 * a comment on the PR. A failed post records nothing.
 */
export default async function postAndRecord({ pr, title, reviewers, teams,
  sha, channels }: Input) {
  /** The Slack posts, one line per channel, with the permalink of each. */
  const posted: Posted = await request(
    @./post_and_record/post_request(pr=pr, title=title, reviewers=reviewers,
    teams=teams, channels=channels));

  if (!posted.posted) {
    return `Return: posted no for ${pr}: a Slack post failed.`;
  }

  /** The comments that record each post on the PR. */
  const recorded: Recorded = await request(
    @./post_and_record/record_request(pr=pr, sha=sha, links=posted.links));

  if (!recorded.recorded) {
    return `Return: posted yes for ${pr}, but a record comment failed. Links:
    ${posted.links}.`;
  }

  return `Return: posted yes for ${pr}. Links: ${posted.links}.`;
}
