interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The title of the pull request. */
  title: string;
  /** The owner and repo of the pull request, such as owner/repo. */
  repo: string;
  /** The CODEOWNERS teams of the pull request, or none. */
  teams: string;
  /** The logins of the requested reviewers, or none. */
  reviewers: string;
  /** The head commit sha that is asked. */
  sha: string;
}

interface Found {
  /** Is at least one channel chosen? */
  found: boolean;
  /** The chosen channels as name (id), separated by semicolons, or none. */
  channels: string;
  /** The Slack user groups as @handle, separated by spaces, or none. */
  groups: string;
}

/**
 * Find the channels and user groups for a new review request, then post it.
 * Nothing is posted when no channel is found.
 */
export default async function findAndPost({ pr, title, repo, teams,
  reviewers, sha }: Input) {
  /** The channels to ask and the user groups to name, found at run time. */
  const found: Found = await request(
    @./find_and_post/find_channels(pr=pr, repo=repo, teams=teams,
    reviewers=reviewers));

  if (!found.found) {
    return `Return: no channel for ${pr}. Nothing posted.`;
  }

  return @./find_and_post/post_and_record(pr=pr, title=title,
    reviewers=reviewers, teams=teams, sha=sha, channels=found.channels,
    groups=found.groups);
}
