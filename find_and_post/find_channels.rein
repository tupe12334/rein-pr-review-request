interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The owner and repo of the pull request, such as owner/repo. */
  repo: string;
  /** The CODEOWNERS teams of the pull request, or none. */
  teams: string;
  /** The logins of the requested reviewers, or none. */
  reviewers: string;
}

/**
 * The text that finds the Slack channels and user groups for a review
 * request at run time. No channel or group name is written in this program.
 * It posts nothing.
 */
export default function findChannels({ pr, repo, teams, reviewers }: Input) {
  return `Find the Slack channels where ${pr} should be asked for review. Do
  not use any channel name from memory. First search the messages of the
  last 30 days (slack_search_public_and_private) for pull request links of
  ${repo}, or of its owner, that ask for a review. Then search the channels
  (slack_search_channels) whose name or topic matches review, PR, code-review,
  the repo name, or the teams ${teams}. For each candidate, read its topic
  and purpose. Drop a channel whose topic or purpose says that review
  requests do not belong there. Choose one channel, or two at most, where
  such requests are posted. Then find the Slack user groups for the teams
  ${teams} and for the team of the reviewers ${reviewers}: search each team
  name (slack_search_public_and_private, slack_search_channels). Keep only
  an @handle that the results show. Never invent a handle. Answer found yes
  when you chose a channel, otherwise no. Answer channels: each chosen
  channel as name (id), separated by semicolons, or none. Answer groups:
  each user group as @handle, separated by spaces, or none. Post nothing.`;
}
