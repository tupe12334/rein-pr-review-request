interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The title of the pull request. */
  title: string;
  /** The logins of the requested reviewers, or none. */
  reviewers: string;
  /** The CODEOWNERS teams of the pull request, or none. */
  teams: string;
  /** The chosen channels as name (id), separated by semicolons. */
  channels: string;
  /** The Slack user groups as @handle, separated by spaces, or none. */
  groups: string;
}

/**
 * The text that posts one line for the pull request in each chosen channel,
 * in the channel's usual phrasing.
 */
export default function postRequest({ pr, title, reviewers, teams, channels,
  groups }: Input) {
  return `Post one line for ${pr} in each channel of ${channels}. Use
  "🤖 ${title} needs a review: ${pr}", changed to match the usual phrasing of
  that channel: read its last 30 days of review requests first.
  Mention the reviewers ${reviewers} or the team ${teams} only when that
  channel's past review requests do. Mention the user group ${groups} only
  when that channel's past review requests mention a user group. Post once
  per channel, and nothing else. Answer posted yes when every post succeeded,
  otherwise no. Answer links: each post as <#channel> (<permalink>),
  separated by semicolons.`;
}
