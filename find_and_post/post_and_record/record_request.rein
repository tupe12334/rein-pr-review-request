interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The head commit sha that was asked. */
  sha: string;
  /** Each post as <#channel> (<permalink>), separated by semicolons. */
  links: string;
}

/**
 * The text that records each Slack post as a comment on the pull request, so
 * that the next run sees the request for this head.
 */
export default function recordRequest({ pr, sha, links }: Input) {
  return `For each post in ${links}, comment on ${pr} with the text
  "🤖 Review requested in <#channel> (<permalink>) at ${sha}", using the
  channel and the permalink of that post. Comment once per post. Change
  nothing else. Answer recorded yes when every comment was posted, otherwise
  no.`;
}
