interface Input {
  /** The link of the pull request. */
  pr: string;
  /** The owner and repo of the pull request, such as owner/repo. */
  repo: string;
  /** The CODEOWNERS teams of the pull request, or none. */
  teams: string;
}

/**
 * The text that finds the Slack channels for a review request at run time.
 * No channel name is written in this program. It posts nothing.
 */
export default function findChannels({ pr, repo, teams }: Input) {
  return `Find the Slack channels where ${pr} should be asked for review. Do
  not use any channel name from memory. First search the messages of the
  last 30 days (slack_search_public_and_private) for pull request links of
  ${repo}, or of its owner, that ask for a review. Then search the channels
  (slack_search_channels) whose name or topic matches review, PR, code-review,
  the repo name, or the teams ${teams}. For each candidate, read its topic
  and purpose. Drop a channel whose topic or purpose says that review
  requests do not belong there. Choose one channel, or two at most, where
  such requests are posted. Answer found yes when you chose a channel,
  otherwise no. Answer channels: each chosen channel as name (id), separated
  by semicolons, or none. Post nothing.`;
}
